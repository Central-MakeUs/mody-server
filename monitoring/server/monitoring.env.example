# 서버 ~/monitoring/server/monitoring.env 로 복사해 값을 채운다. 커밋하지 않는다.
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=admin
# 팀 공유용 Viewer 계정(mody-team) 비밀번호 메모 (Grafana UI에서 생성)
# GRAFANA_VIEWER_PASSWORD=
# 운영 DB의 읽기 전용 계정 (운영 서버에 생성해 둠)
GRAFANA_DB_USER=grafana
GRAFANA_DB_PASSWORD=
EXPORTER_DB_USER=exporter
EXPORTER_DB_PASSWORD=
